---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";
import { Icon } from "@astrojs/starlight/components";
import { SITE_COPY } from "../i18n/site-copy.mjs";

const locale = Astro.locals?.starlightRoute?.locale === "en-US" ? "en-US" : "root";
const copy = SITE_COPY[locale];
const sourceUrl = "https://github.com/HagiCode-org/openspec-docs";
---

<footer class="sl-flex site-footer">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <nav aria-label={copy.footerLabel}>
    <a href="/" lang="zh-CN" aria-label={SITE_COPY.root.homeLabel}>OpenSpec 文档</a>
    <a href="/en-US/" lang="en-US" aria-label={SITE_COPY["en-US"].homeLabel}>OpenSpec Docs</a>
    <a href={sourceUrl}><Icon name="github" /> {copy.sourceLabel}</a>
    <a href={`${sourceUrl}/issues`}>{copy.issuesLabel}</a>
  </nav>
  <p>© {new Date().getFullYear()} {copy.copyright}</p>
  <a class="kudos sl-flex" href="https://starlight.astro.build">
    <Icon name="starlight" /> {Astro.locals.t("builtWithStarlight.label")}
  </a>
</footer>

<style>
  @layer starlight.core {
    .site-footer {
      flex-direction: column;
      gap: 1rem;
      padding-block: 1.5rem;
      border-top: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    .meta {
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem 2rem;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    a {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: inherit;
      text-decoration: none;
    }

    a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
    }

    a:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 3px;
    }

    p {
      margin: 0;
    }

    .kudos {
      justify-content: center;
    }
  }
</style>
