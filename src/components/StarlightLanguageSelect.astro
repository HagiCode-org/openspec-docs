---
import { getCollection } from "astro:content";
import { getLocaleHref } from "../lib/locale-navigation.mjs";
import { SITE_COPY } from "../i18n/site-copy.mjs";

const locale = Astro.locals?.starlightRoute?.locale === "en-US" ? "en-US" : "root";
const targetLocale = locale === "root" ? "en-US" : "root";
const copy = SITE_COPY[locale];
const publishedIds = (await getCollection("docs")).map(({ id }) => id);
const languageHref = getLocaleHref(Astro.url.pathname, targetLocale, publishedIds);
---

<a
  class="language-link"
  href={languageHref}
  hreflang={SITE_COPY[targetLocale].lang}
  aria-label={copy.languageControlLabel}
>
  {copy.languageLabel}
</a>

<style>
  .language-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.5rem;
    border-radius: var(--sl-radius-sm);
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .language-link:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .language-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
