---
import { getCollection } from "astro:content";
import { isSiteLocale, LANGUAGE_OPTIONS, SITE_COPY } from "../i18n/site-copy.mjs";
import { getLocaleHref } from "../lib/locale-navigation.mjs";

const requestedLocale = Astro.locals?.starlightRoute?.locale;
const locale = isSiteLocale(requestedLocale)
  ? requestedLocale
  : "en-US";
const copy = SITE_COPY[locale];
const publishedIds = (await getCollection("docs")).map(({ id }) => id);
const options = LANGUAGE_OPTIONS.map((option) => ({
  ...option,
  href: getLocaleHref(Astro.url.pathname, option.code, publishedIds),
}));
const dialogId = `language-dialog-${crypto.randomUUID()}`;
---

<div class="language-control" data-language-chooser>
  <button
    class="language-trigger"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={dialogId}
    aria-label={copy.languageControlLabel}
    title={copy.languageLabel}
  >
    <span>{copy.languageLabel}</span>
    <span class="language-trigger__icon" aria-hidden="true">⌄</span>
  </button>
  <dialog class="language-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
    <div class="language-dialog__header">
      <div>
        <h2 id={`${dialogId}-title`}>{copy.dialogTitle}</h2>
        <p>{copy.currentLocaleLabel}: <strong>{copy.languageLabel}</strong></p>
      </div>
      <form method="dialog">
        <button class="language-dialog__close" type="submit" aria-label={copy.closeLabel}>×</button>
      </form>
    </div>
    <ul class="language-options" aria-label={copy.dialogTitle}>
      {options.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.lang}
            lang={option.lang}
            aria-current={option.code === locale ? "page" : undefined}
            data-language-option
            data-locale={option.code}
          >
            <span>{option.label}</span>
            {option.code === locale && <span class="language-option__selected">{copy.selectedStateLabel}</span>}
          </a>
        </li>
      ))}
    </ul>
  </dialog>
  <noscript>
    <nav class="language-fallback" aria-label={copy.dialogTitle}>
      <span>{copy.currentLocaleLabel}: {copy.languageLabel}</span>
      <ul class="language-options">
        {options.map((option) => (
          <li>
            <a href={option.href} hreflang={option.lang} lang={option.lang}>
              {option.label}
              {option.code === locale && <span class="language-option__selected">{copy.selectedStateLabel}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </noscript>
</div>

<script>
  import {
    preserveUrlContext,
    writeBrowserLocalePreference,
  } from "../lib/locale-navigation.mjs";

  document.querySelectorAll("[data-language-chooser]").forEach((chooser) => {
    const trigger = chooser.querySelector(".language-trigger");
    const dialog = chooser.querySelector(".language-dialog");
    const currentOption = chooser.querySelector<HTMLAnchorElement>('[data-language-option][aria-current="page"]');

    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    if (typeof dialog.showModal !== "function") {
      trigger.disabled = true;
      return;
    }

    trigger.addEventListener("click", () => {
      dialog.showModal();
      trigger.setAttribute("aria-expanded", "true");
      currentOption?.focus();
    });

    dialog.addEventListener("close", () => {
      trigger.setAttribute("aria-expanded", "false");
      trigger.focus();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      const options = [...dialog.querySelectorAll<HTMLAnchorElement>("[data-language-option]")];
      const currentIndex = options.findIndex((option) => option === document.activeElement);
      if (currentIndex < 0 || options.length === 0) return;

      let nextIndex;
      switch (event.key) {
        case "ArrowDown":
        case "ArrowRight":
          nextIndex = (currentIndex + 1) % options.length;
          break;
        case "ArrowUp":
        case "ArrowLeft":
          nextIndex = (currentIndex - 1 + options.length) % options.length;
          break;
        case "Home":
          nextIndex = 0;
          break;
        case "End":
          nextIndex = options.length - 1;
          break;
        default:
          return;
      }

      event.preventDefault();
      options[nextIndex]?.focus();
    });

    dialog.querySelectorAll("[data-language-option]").forEach((option) => {
      option.addEventListener("click", (event) => {
        if (!(option instanceof HTMLAnchorElement)) return;
        if (option.getAttribute("aria-current") === "page") {
          event.preventDefault();
          dialog.close();
          return;
        }

        event.preventDefault();
        const targetLocale = option.dataset.locale;
        if (!targetLocale) throw new Error("Language option is missing its locale code.");
        writeBrowserLocalePreference(targetLocale);
        const targetUrl = preserveUrlContext(option.href, new URL(window.location.href));
        window.location.assign(targetUrl);
      });
    });
  });
</script>

<style>
  .language-control {
    min-width: 0;
  }

  .language-trigger {
    display: inline-flex;
    max-width: 12rem;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.55rem;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--sl-radius-sm);
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font: inherit;
    font-size: var(--sl-text-sm);
  }

  .language-trigger > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .language-trigger:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .language-trigger:focus-visible,
  .language-dialog a:focus-visible,
  .language-dialog button:focus-visible,
  .language-fallback a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .language-trigger__icon {
    flex: 0 0 auto;
  }

  .language-dialog {
    position: fixed;
    inset: 0;
    width: min(34rem, calc(100vw - 2rem));
    max-width: none;
    max-height: min(38rem, calc(100dvh - 2rem));
    margin: auto;
    padding: 1.25rem;
    overflow: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 24%);
  }

  .language-dialog::backdrop {
    background: rgb(0 0 0 / 56%);
  }

  .language-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .language-dialog__header h2 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }

  .language-dialog__header p {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .language-dialog__close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-full);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 1.4rem;
  }

  .language-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .language-options a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-md);
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .language-options a:hover,
  .language-options a[aria-current="page"] {
    border-color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
  }

  .language-option__selected {
    flex: 0 0 auto;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
  }

  .language-fallback {
    position: absolute;
    z-index: 100;
    width: min(34rem, calc(100vw - 2rem));
    max-height: 80vh;
    padding: 1rem;
    overflow: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-color-bg-nav);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 24%);
  }

  .language-fallback > span {
    display: block;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 30rem) {
    .language-trigger {
      max-width: 8rem;
    }

    .language-dialog {
      padding: 1rem;
    }

    .language-options {
      grid-template-columns: 1fr;
    }
  }
</style>
