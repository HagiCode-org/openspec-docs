---
type Props = {
  href?: string | null;
  copy: {
    label: string;
    title: string;
    description: string;
    viewOriginal: string;
  };
};

const { href, copy } = Astro.props;
---

<aside class="ai-translation-notice" aria-label={copy.title}>
  <p class="ai-translation-notice__label">{copy.label}</p>
  <p class="ai-translation-notice__title">{copy.title}</p>
  <p class="ai-translation-notice__description">{copy.description}</p>
  {href && <a class="ai-translation-notice__link" href={href}>{copy.viewOriginal}</a>}
</aside>
