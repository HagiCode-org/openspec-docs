---
import HagilightMarkdownContent from "@hagicode/hagilight-starlight/MarkdownContent";
import PromotoBanner from "@hagicode/hagilight/PromotoBanner";
import HagiCodeEndCard from "./HagiCodeEndCard.astro";
import { isSiteLocale, SITE_COPY } from "../i18n/site-copy.mjs";
import { getEnglishTopicHref } from "../lib/locale-navigation.mjs";

const route = Astro.locals.starlightRoute;
const locale = isSiteLocale(route?.locale)
  ? route.locale
  : "en-US";
const isFallback = route?.entry.data.isEnglishFallback === true;
const englishHref = getEnglishTopicHref(Astro.url.pathname);
const aiDisclosures = {
  isAITranslation: false,
  isAIAuthor: false,
  sourceLocale: "en-US",
};
const fallbackPromotion = {
  id: "openspec-docs-hagicode-fallback",
  title: SITE_COPY[locale].promoteTitle,
  description: SITE_COPY[locale].promoteDescription,
  ctaLabel: SITE_COPY[locale].promoteVisitLabel,
  link: "https://www.hagicode.com",
  image: {
    src: "/img/hagicode/light-main.png",
    alt: SITE_COPY[locale].promoteImageAlt,
    width: 3137,
    height: 1235,
  },
};
---

<HagilightMarkdownContent aiDisclosures={aiDisclosures}>
  {isFallback && (
    <aside class="english-fallback-notice">
      <p>
        {SITE_COPY[locale].englishFallbackNotice}
        <a href={englishHref}>{SITE_COPY[locale].englishFallbackLinkLabel}</a>
      </p>
    </aside>
  )}
  {isFallback ? <div lang="en-US"><slot /></div> : <slot />}
</HagilightMarkdownContent>
<HagiCodeEndCard />
<PromotoBanner locale={locale} fallback={fallbackPromotion} />

<style>
  .english-fallback-notice {
    margin-block-end: 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 0.25rem solid var(--sl-color-text-accent);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-color-gray-6);
  }

  .english-fallback-notice p {
    margin: 0;
  }

  .english-fallback-notice a {
    margin-inline-start: 0.35em;
  }
</style>
