---
import HagilightMarkdownContent from "@hagicode/hagilight-starlight/MarkdownContent";
import { isSiteLocale, SITE_COPY } from "../i18n/site-copy.mjs";
import { getEnglishTopicHref } from "../lib/locale-navigation.mjs";

const route = Astro.locals.starlightRoute;
const locale = isSiteLocale(route?.locale) ? route.locale : "en-US";
const isFallback = route?.entry.data.isEnglishFallback === true;
const englishHref = getEnglishTopicHref(Astro.url.pathname);
const aiDisclosures = {
  isAITranslation: !isFallback,
  isAIAuthor: false,
  sourceLocale: "en-US",
};
---

<HagilightMarkdownContent aiDisclosures={aiDisclosures}>
  {isFallback && (
    <aside class="english-fallback-notice">
      <p>
        {SITE_COPY[locale].englishFallbackNotice}
        <a href={englishHref}>{SITE_COPY[locale].englishFallbackLinkLabel}</a>
      </p>
    </aside>
  )}
  {isFallback ? <div lang="en-US"><slot /></div> : <slot />}
</HagilightMarkdownContent>

<style>
  .english-fallback-notice {
    margin-block-end: 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 0.25rem solid var(--sl-color-text-accent);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-color-gray-6);
  }

  .english-fallback-notice p {
    margin: 0;
  }

  .english-fallback-notice a {
    margin-inline-start: 0.35em;
  }
</style>
