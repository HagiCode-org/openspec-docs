---
import { isSiteLocale, SITE_COPY } from "../i18n/site-copy.mjs";

const locale = isSiteLocale(Astro.locals?.starlightRoute?.locale)
  ? Astro.locals.starlightRoute.locale
  : "en-US";
const copy = SITE_COPY[locale];
---

<section class="hagicode-end-card" aria-labelledby="hagicode-end-card-title" data-hagicode-end-card>
  <div class="hagicode-end-card__intro">
    <h2 id="hagicode-end-card-title">{copy.hagicodeTitle}</h2>
    <p class="hagicode-end-card__lead">{copy.hagicodeLead}</p>
    <p class="hagicode-end-card__subheadline">{copy.hagicodeSubheadline}</p>
  </div>
  <figure class="hagicode-end-card__visual">
    <img
      src="/img/hagicode/light-main.png"
      alt={copy.hagicodeImageAlt}
      width="3137"
      height="1235"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <ul class="hagicode-end-card__features" aria-label={copy.hagicodeTitle}>
    {copy.hagicodeFeatures.map((feature) => (
      <li data-hagicode-feature>
        <strong>{feature.label}</strong>
        <span>{feature.description}</span>
      </li>
    ))}
  </ul>
  <a class="hagicode-end-card__visit" href="https://www.hagicode.com">{copy.hagicodeVisitLabel}</a>
</section>
